# Copy to a private .env; populate credentials on the server only.
# Existing SQL/RabbitMQ volumes require changing the actual service credentials too.
SA_PASSWORD=
SQLString=
Redis__ConnectionString=novastay-redis:6379
RabbitMQ_HostName=novastay-rabbit
RabbitMQ_UserName=novastay
RabbitMQ_Password=
MinIO__Endpoint=novastay-minio:9000
MinIO__AccessKey=novastay
MinIO__SecretKey=
MinIO__BucketName=novastay
MinIO__UseSSL=false
MinIO__PublicEndpoint=https://api.nestone.io.vn/minio
# Generate a new random signing key, at least 32 bytes. Never use an example key.
JWT__SecretKey=
JWT__Issuer=NovaStay
JWT__Audience=NovaStayUsers
JWT__AccessTokenMinutes=60
JWT__RefreshTokenDays=30
SMTP__Host=smtp.gmail.com
SMTP__Port=587
SMTP__Username=
SMTP__Password=
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
