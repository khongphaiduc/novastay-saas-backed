# Optional overrides; defaults below contain no secrets.
# Set ReverseProxy__KnownProxies__0 separately to the verified production proxy IP.
Security__RateLimits__AuthLogin__PermitLimit=30
Security__RateLimits__AuthLogin__WindowSeconds=60
Security__RateLimits__AuthRegister__PermitLimit=10
Security__RateLimits__AuthRegister__WindowSeconds=3600
Security__RateLimits__AuthReset__PermitLimit=5
Security__RateLimits__AuthReset__WindowSeconds=900
Security__RateLimits__AuthRefresh__PermitLimit=60
Security__RateLimits__AuthRefresh__WindowSeconds=60
Security__RateLimits__AuthPassword__PermitLimit=5
Security__RateLimits__AuthPassword__WindowSeconds=900
Security__RateLimits__PaymentLink__PermitLimit=10
Security__RateLimits__PaymentLink__WindowSeconds=60
Security__RateLimits__PaymentReconcile__PermitLimit=6
Security__RateLimits__PaymentReconcile__WindowSeconds=60
Security__RateLimits__BankAccount__PermitLimit=5
Security__RateLimits__BankAccount__WindowSeconds=60
Security__RateLimits__SendNotice__PermitLimit=10
Security__RateLimits__SendNotice__WindowSeconds=600
Security__RateLimits__Invitation__PermitLimit=20
Security__RateLimits__Invitation__WindowSeconds=60
Security__RateLimits__PaymentHub__PermitLimit=30
Security__RateLimits__PaymentHub__WindowSeconds=60
